<Window x:Class="GirderSchedule.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GirderSchedule.App.Views.Controls"
        Title="내보내기"
        Width="1400"
        Height="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,16,0"
                Background="#E5E5E5"
                BorderBrush="#B3B3B3"
                BorderThickness="1">
            <controls:ExportPreviewControl DataContext="{Binding Preview}" />
        </Border>

        <Border Grid.Column="1"
                Padding="12"
                Background="#F7F7F7"
                BorderBrush="#B3B3B3"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="파일명"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="파일 형식"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1"
                              Height="28"
                              ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="저장 위치"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            Margin="6,0,0,0"
                            Content="+"
                            Command="{Binding BrowseFolderCommand}" />
                </Grid>

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding PageItems}"
                         SelectedIndex="{Binding SelectedPageIndex}"
                         BorderBrush="#C8C8C8"
                         BorderThickness="1" />

                <StackPanel Grid.Row="4"
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="92"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="뒤로가기"
                            Command="{Binding CloseCommand}" />

                    <Button Width="92"
                            Height="32"
                            Content="내보내기"
                            Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>