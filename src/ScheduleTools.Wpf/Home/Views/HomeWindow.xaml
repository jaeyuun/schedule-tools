<Window x:Class="ScheduleTools.Wpf.Home.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ScheduleTools.Wpf.Converters"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <converters:SearchIconTextConverter x:Key="SearchIconTextConverter"/>

        <Style x:Key="HomeRecentExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="HeaderSite" Grid.Row="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderBorder" Padding="0,4" Background="Transparent" CornerRadius="{StaticResource SectionCornerRadius}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Path x:Name="Arrow" Grid.Column="0" Style="{StaticResource TreeToggleArrowPathStyle}"/>
                                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ContentSource="Content" RecognizesAccessKey="True"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" ContentSource="Header"/>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Margin="18,6,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ink300Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeRecentProjectListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="HomeRecentProjectItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Padding="8" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SectionCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Blue050Brush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Blue100Brush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeSearchClearButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource GridRowGapXLarge}"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapXLarge}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapLarge}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="최근 프로젝트" Style="{StaticResource TitleTextStyle}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ClearSearchCommand}" Style="{StaticResource HomeSearchClearButtonStyle}">
                        <TextBlock Margin="{StaticResource HorMarginMedium}" Text="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource SearchIconTextConverter}}" Style="{StaticResource CaptionTextStyle}"/>
                    </Button>
                </Grid>

                <Button Grid.Column="2" Content="새로고침" Command="{Binding RefreshCommand}" Style="{StaticResource ModernOutlineButtonStyle}"/>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <ScrollViewer x:Name="RecentProjectScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentProjectGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="18,18,18,0" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Style="{StaticResource HomeRecentExpanderStyle}">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleTextStyle}"/>
                                        </Expander.Header>

                                        <ListBox ItemsSource="{Binding Projects}"
                                                 SelectedItem="{Binding DataContext.SelectedRecentProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource HomeRecentProjectItemStyle}"
                                                 Style="{StaticResource HomeRecentProjectListBoxStyle}"
                                                 PreviewMouseWheel="RecentProjectListBox_PreviewMouseWheel"
                                                 KeyDown="RecentProjectListBox_KeyDown"
                                                 MouseDoubleClick="RecentProjectListBox_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" MinWidth="0">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}"/>
                                                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Style="{StaticResource DefaultTextStyle}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Margin="{StaticResource HorMarginMedium}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding LastOpenedText}" Style="{StaticResource DefaultTextStyle}"/>
                                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text=" ›" Style="{StaticResource CaptionTextStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock HorizontalAlignment="Center" Text="최근 프로젝트가 없습니다." Style="{StaticResource DefaultTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Column="2">
            <TextBlock Margin="{StaticResource VerMarginXLarge}" Text="프로젝트 시작" Style="{StaticResource TitleTextStyle}"/>

            <Button Height="120" Margin="{StaticResource VerMarginMedium}" Command="{Binding OpenProjectCommand}" Style="{StaticResource ModernButtonStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Margin="{StaticResource VerMarginSmall}" Text="기존 프로젝트 가져오기" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="저장된 프로젝트를 이어서 작업합니다." Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </Button>

            <Button Height="120" Command="{Binding CreateProjectCommand}" Style="{StaticResource ModernButtonStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Margin="{StaticResource VerMarginSmall}" Text="새 프로젝트 시작하기" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="새 프로젝트 이름과 도면명을 설정합니다." Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>