<Window x:Class="GirderSchedule.App.Views.Settings.DxfExportSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF 내보내기"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SettingWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OkCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource GridRowGapLarge}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="내보내기 옵션" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="DXF 출력 방식과 한 줄에 배치할 도면 개수를 설정합니다." Style="{StaticResource CaptionTextStyle}"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2">
            <Border Margin="{StaticResource VerMarginMedium}" Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="층 출력 방식" Margin="{StaticResource VerMarginMedium}" Style="{StaticResource SectionTitleTextStyle}"/>
                    <CheckBox Content="층 구분 없이 이어서 출력" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding ContinueAcrossFloors, Mode=TwoWay}"/>
                    <TextBlock Text="체크하면 층이 바뀌어도 이어서 출력하고, 해제하면 층이 바뀔 때 다음 줄부터 출력합니다." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel Margin="{StaticResource VerMarginSmall}">
                    <TextBlock Text="도면 배치" Margin="{StaticResource VerMarginMedium}" Style="{StaticResource SectionTitleTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource VerMarginSmall}">
                        <TextBlock Grid.Column="0" Text="도면 가로 개수" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource DefaultTextStyle}"/>
                        <TextBox Grid.Column="1" Width="60" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormColumnCountText, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Column="2" Text="개" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource DefaultTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="(기본값: 3)" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <TextBlock Text="도면 1개는 부재 9세트 기준입니다. 예: 4 입력 시 도면1 도면2 도면3 도면4 / 도면5 도면6 ..." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding CancelCommand}"/>
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OkCommand}"/>
        </StackPanel>
    </Grid>
</Window>