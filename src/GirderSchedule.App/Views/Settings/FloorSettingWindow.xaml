<Window x:Class="GirderSchedule.App.Views.Settings.FloorSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="층 설정"
        Width="1040"
        Height="660"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding UpdateCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <Grid Grid.Column="0" Grid.RowSpan="2" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="층 목록" Style="{StaticResource WindowTitleTextStyle}"/>
                        <TextBlock Text="도면에 출력할 층 이름과 층별 기본 철근 규격을 관리합니다." Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                            x:Name="FloorGrid"
                            ItemsSource="{Binding Floors}"
                            SelectedItem="{Binding SelectedFloor, Mode=TwoWay}"
                            AllowDrop="True"
                            PreviewMouseLeftButtonDown="FloorGrid_PreviewMouseLeftButtonDown"
                            MouseMove="FloorGrid_MouseMove"
                            DragOver="FloorGrid_DragOver"
                            DragLeave="FloorGrid_DragLeave"
                            Drop="FloorGrid_Drop"
                            Style="{StaticResource ModernDataGridStyle}"
                            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                            RowStyle="{StaticResource ModernDataGridRowStyle}"
                            CellStyle="{StaticResource ModernDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="층 표현" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FloorPrefix}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding FloorPrefix, UpdateSourceTrigger=LostFocus}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="층 이름" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FloorName}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource GridCellTextBoxStyle}" HorizontalContentAlignment="Left" Text="{Binding FloorName, UpdateSourceTrigger=LostFocus}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="주근 규격" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MainRebarText}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid Height="26" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="HD" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding MainRebarDiameterText, UpdateSourceTrigger=LostFocus}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="스터럽 규격" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StirrupText}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid Height="26" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="HD" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding StirrupDiameterText, UpdateSourceTrigger=LostFocus}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="표피철근 규격" Width="1.14*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SkinRebarText}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid Height="26" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="HD" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Margin="0,0,16,0" Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding SkinRebarDiameterText, UpdateSourceTrigger=LostFocus}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                </Grid>

                <Border Grid.Column="1" Grid.Row="0" Background="#FBFDFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" CornerRadius="0,12,0,0" VerticalAlignment="Stretch">
                    <StackPanel Margin="22">
                        <TextBlock Text="선택한 층 정보" Style="{StaticResource WindowTitleTextStyle}"/>
                        <TextBlock Text="입력 후 추가 또는 수정 버튼을 누르세요." Margin="0,6,0,16" Style="{StaticResource CaptionTextStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="7"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="층 표현" FontWeight="SemiBold" Foreground="{StaticResource Ink700Brush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="층 이름" FontWeight="SemiBold" Foreground="{StaticResource Ink700Brush}"/>
                            <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputFloorPrefix, UpdateSourceTrigger=LostFocus}"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputFloorName, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <TextBlock Text="주근 규격" FontWeight="SemiBold" Foreground="{StaticResource Ink700Brush}"/>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HD" VerticalAlignment="Center" Foreground="{StaticResource Ink500Brush}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputMainRebarDiameter, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <TextBlock Text="스터럽 규격" FontWeight="SemiBold" Foreground="{StaticResource Ink700Brush}"/>
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HD" VerticalAlignment="Center" Foreground="{StaticResource Ink500Brush}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputStirrupDiameter, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <TextBlock Text="표피철근 규격" FontWeight="SemiBold" Foreground="{StaticResource Ink700Brush}"/>
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HD" VerticalAlignment="Center" Foreground="{StaticResource Ink500Brush}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputSkinRebarDiameter, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="추가" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding AddCommand}"/>
                            <Button Grid.Column="2" Content="수정" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding UpdateCommand}"/>
                            <Button Grid.Column="4" Content="삭제" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding RemoveCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Background="#FBFDFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,0" CornerRadius="0,0,12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                        <Button Content="닫기" Width="96" Style="{StaticResource ModernPrimaryButtonStyle}" IsCancel="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>