<Window x:Class="GirderSchedule.App.Views.Settings.FloorSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="층 설정"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SettingWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding UpdateCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="FloorGridCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RebarInputGridStyle" TargetType="Grid">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource GridRowGapLarge}"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="층 목록" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="도면에 출력할 층 이름과 층별 기본 철근 규격을 관리합니다." Style="{StaticResource CaptionTextStyle}"/>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      x:Name="FloorGrid"
                      ItemsSource="{Binding Floors}"
                      SelectedItem="{Binding SelectedFloor, Mode=TwoWay}"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="FloorGrid_PreviewMouseLeftButtonDown"
                      MouseMove="FloorGrid_MouseMove"
                      DragOver="FloorGrid_DragOver"
                      DragLeave="FloorGrid_DragLeave"
                      Drop="FloorGrid_Drop"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                      CellStyle="{StaticResource ModernDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="층 표현" Width="0.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FloorPrefix}" Style="{StaticResource DefaultTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding FloorPrefix, UpdateSourceTrigger=LostFocus}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="층 이름" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FloorName}" Style="{StaticResource DefaultTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding FloorName, UpdateSourceTrigger=LostFocus}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="주근 규격" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MainRebarText}" Style="{StaticResource DefaultTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HD" Margin="{StaticResource HorMarginSamll}" Style="{StaticResource DefaultTextStyle}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding MainRebarDiameterText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="스터럽 규격" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StirrupText}" Style="{StaticResource DefaultTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HD" Margin="{StaticResource HorMarginSamll}" Style="{StaticResource DefaultTextStyle}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding StirrupDiameterText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="표피철근 규격" Width="1.14*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SkinRebarText}" Style="{StaticResource DefaultTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HD" Margin="{StaticResource HorMarginSamll}" Style="{StaticResource DefaultTextStyle}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LastGridCellTextBoxStyle}" Text="{Binding SkinRebarDiameterText, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="0" Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="선택한 층 정보" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="입력 후 추가 또는 수정 버튼을 누르세요." Margin="{StaticResource VerMarginMedium}" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <Grid Margin="{StaticResource VerMarginMedium}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="층 표현" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="층 이름" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputFloorPrefix, UpdateSourceTrigger=LostFocus}"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputFloorName, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>

                    <TextBlock Text="주근 규격" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Grid Margin="{StaticResource VerMarginMedium}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HD" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputMainRebarDiameter, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>

                    <TextBlock Text="스터럽 규격" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Grid Margin="{StaticResource VerMarginMedium}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HD" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputStirrupDiameter, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>

                    <TextBlock Text="표피철근 규격" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource SectionTitleTextStyle}"/>
                    <Grid Margin="{StaticResource VerMarginMedium}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HD" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource CaptionTextStyle}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputSkinRebarDiameter, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>

                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="추가" Style="{StaticResource PrimaryMiniButtonStyle}" Command="{Binding AddCommand}"/>
                        <Button Grid.Column="2" Content="수정" Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding UpdateCommand}"/>
                        <Button Grid.Column="4" Content="삭제" Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding RemoveCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Style="{StaticResource PrimaryButtonStyle}" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>