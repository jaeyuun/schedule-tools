<Window x:Class="GirderSchedule.App.Views.Settings.AppSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경 설정"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SettingWindowStyle}">

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource GridRowGapLarge}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapXLarge}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapXLarge}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="환경 설정" Style="{StaticResource TitleTextStyle}"/>

            <TextBlock Grid.Row="2" Text="기본 저장 폴더" Style="{StaticResource SectionTitleTextStyle}"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding DefaultProjectFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Content="..." Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding BrowseProjectFolderCommand}"/>
            </Grid>

            <TextBlock Grid.Row="6" Text="기본 글자 크기" Style="{StaticResource SectionTitleTextStyle}"/>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapLarge}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="36" Content="−" Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding DecreaseFontSizeCommand}" IsEnabled="{Binding CanDecreaseFontSize}"/>

                <Border Grid.Column="2" Width="64" Height="32" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource MiniCornerRadius}">
                    <TextBlock Text="{Binding DefaultFontSizeText}" FontSize="{DynamicResource DefaultFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="4" Width="36" Content="+" Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding IncreaseFontSizeCommand}" IsEnabled="{Binding CanIncreaseFontSize}"/>
                <Button Grid.Column="6" Content="기본값" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding ResetFontSizeCommand}"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="확인" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>