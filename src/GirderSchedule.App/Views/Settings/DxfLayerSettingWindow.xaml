<Window x:Class="GirderSchedule.App.Views.Settings.DxfLayerSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF 설정"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SettingWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource GridRowGapLarge}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    
        <StackPanel Grid.Row="0">
            <TextBlock Text="DXF 설정" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="공유 템플릿, 스타일, 레이어 설정을 관리합니다." Style="{StaticResource CaptionTextStyle}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapLarge}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="설정" Style="{StaticResource SectionTitleTextStyle}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SettingNames}" SelectedItem="{Binding SelectedSettingName}" Style="{StaticResource ModernComboBoxStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SettingNameText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                <Button Grid.Row="0" Grid.Column="5" Content="저장" Style="{StaticResource PrimaryMiniButtonStyle}" Command="{Binding SaveSettingCommand}"/>
                <Button Grid.Row="0" Grid.Column="7" Content="삭제" Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding DeleteSettingCommand}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="템플릿" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource SectionTitleTextStyle}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding TemplateNames}" SelectedItem="{Binding SelectedTemplateName}" Style="{StaticResource ModernComboBoxStyle}"/>
                <Button Grid.Row="2" Grid.Column="5" Content="추가" Style="{StaticResource PrimaryMiniButtonStyle}" Command="{Binding AddTemplateCommand}"/>
                <Button Grid.Row="2" Grid.Column="7" Content="삭제" Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding DeleteTemplateCommand}"/>
            </Grid>
        </Border>
        
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
    
                    <TextBlock Grid.Row="0" Text="스타일 설정" Style="{StaticResource SectionTitleTextStyle}"/>
    
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Styles}"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="항목" Width="0.5*" Binding="{Binding DisplayName}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="스타일명" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StyleName}" Style="{StaticResource DefaultTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource GridCellTextBoxStyle}" Text="{Binding StyleName, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
    
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
    
                    <TextBlock Grid.Row="0" Text="레이어 설정" Style="{StaticResource SectionTitleTextStyle}"/>
    
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Layers}"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="항목" Width="0.5*" Binding="{Binding DisplayName}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="레이어명" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LayerName}" Style="{StaticResource DefaultTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource LastGridCellTextBoxStyle}" Text="{Binding LayerName, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="기본값" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding ResetCommand}"/>
            <Button Margin="10,0,0,0" Content="닫기" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>