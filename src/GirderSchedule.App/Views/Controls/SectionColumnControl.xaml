<UserControl x:Class="GirderSchedule.App.Views.Controls.SectionColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="320"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#B8B8B8" BorderThickness="0,0,1,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Margin="18,6,18,2"
                         Height="22"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Title}"/>

                <DockPanel Grid.Row="1" Margin="12,0,12,0">
                    <TextBlock Width="24" Text="M =" FontSize="12"/>
                    <TextBox Width="70"
                             Height="18"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=MValue}"/>
                    <TextBlock Width="24" Margin="18,0,0,0" Text="V =" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Width="70"
                             Height="18"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=VValue}"/>
                </DockPanel>

                <Canvas x:Name="PART_PreviewCanvas"
                        Grid.Row="2"
                        Margin="10,8,10,10"
                        Background="Transparent"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#B8B8B8" BorderThickness="0,0,1,1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,2" VerticalAlignment="Center" Text="1단"/>
                <TextBox Grid.Row="0" Grid.Column="1" Width="32" Height="20"
         Margin="0,0,4,2"
         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopCount1, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,4,0" VerticalAlignment="Center" Text="2단"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="32" Height="20" Margin="0,2,4,0"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopCount2, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center" Text="- HD"/>
                <TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Width="32" Height="20" VerticalAlignment="Center"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopDiameter, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#B8B8B8" BorderThickness="0,0,1,1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,2" VerticalAlignment="Center" Text="1단"/>
                <TextBox Grid.Row="0" Grid.Column="1" Width="32" Height="20" Margin="0,0,4,2"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomCount1, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,4,0" VerticalAlignment="Center" Text="2단"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="32" Height="20" Margin="0,2,4,0"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomCount2, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center" Text="- HD"/>
                <TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Width="32" Height="20" VerticalAlignment="Center"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomDiameter, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#B8B8B8" BorderThickness="0,0,1,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Width="28" Height="20"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StirrupLegs, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="4,0" VerticalAlignment="Center" Text="- HD"/>
                <TextBox Width="28" Height="20"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StirrupDiameter, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="4,0" VerticalAlignment="Center" Text="@"/>
                <TextBox Width="36" Height="20"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StirrupSpacing, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderBrush="#B8B8B8" BorderThickness="0,0,1,1">
            <TextBox Width="140"
                     Height="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SkinRebar, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>
    </Grid>
</UserControl>