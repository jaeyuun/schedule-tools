<UserControl x:Class="GirderSchedule.App.Views.Controls.SectionColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GirderSchedule.App.Views.Controls"
             xmlns:converters="clr-namespace:GirderSchedule.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="320"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#B8B8B8" BorderThickness="0,0,1,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,6,18,2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox VerticalAlignment="Center"
                              Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ShowNoneCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"
                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsNone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"/>

                    <TextBox Width="182"
                             Height="20"
                             Margin="4,0,0,0"
                             IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsInputEnabled}"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Title, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="12,0,12,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsInputEnabled}">
                    <TextBlock Width="24" Text="M =" FontSize="12" VerticalAlignment="Center"/>

                    <TextBox Width="70"
                             Height="20"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=MValue, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Width="24"
                               Margin="18,0,0,0"
                               Text="V ="
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <TextBox Width="70"
                             Height="20"
                             Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=VValue, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Canvas x:Name="PART_PreviewCanvas"
                        Grid.Row="2"
                        Margin="10,8,10,10"
                        Background="Transparent"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#B8B8B8"
                BorderThickness="0,0,1,1"
                IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsInputEnabled}">
            <local:RebarSettingControl
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Count1="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopCount1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Count2="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopCount2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Diameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TopDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#B8B8B8"
                BorderThickness="0,0,1,1"
                IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsInputEnabled}">
            <local:RebarSettingControl
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Count1="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomCount1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Count2="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomCount2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Diameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BottomDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#B8B8B8"
                BorderThickness="0,0,1,1"
                IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsInputEnabled}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Width="28"
                         Height="20"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StirrupLegs, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Margin="4,0" VerticalAlignment="Center" Text="- HD"/>

                <TextBox Width="28"
                         Height="20"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StirrupDiameter, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Margin="4,0" VerticalAlignment="Center" Text="@"/>

                <TextBox Width="36"
                         Height="20"
                         Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StirrupSpacing, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="#B8B8B8"
                BorderThickness="0,0,1,1"
                IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsInputEnabled}">
            <TextBox AcceptsReturn="True"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SkinRebar, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TransparentTextBoxStyle}"/>
        </Border>
    </Grid>
</UserControl>