<UserControl x:Class="GirderSchedule.App.Views.Controls.GirderSchedulePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GirderSchedule.App.Views.Controls">
    <Viewbox Stretch="Uniform">
        <Grid Width="870"
              Height="656"
              Background="#F7F7F7">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="320"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Button Width="70"
                        Height="26"
                        Margin="0,0,0,6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="☑ 부재력"
                        FontSize="10"/>

                <Grid Grid.Row="1" Grid.RowSpan="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="320"/>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="부 재 명"
                                       HorizontalAlignment="Center"
                                       FontSize="14"/>
                            <TextBlock Text="( B × H )"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            BorderBrush="#B8B8B8"
                            BorderThickness="0,1,1,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBox Width="240"
                                     Height="24"
                                     HorizontalAlignment="Center"
                                     Text="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                <TextBlock VerticalAlignment="Center" Text="(" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsWidthOver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    <TextBlock Text="이상" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox Width="60"
                                         Height="22"
                                         Margin="4,0"
                                         Text="{Binding WidthValue, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Text="×" FontSize="15"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsHeightOver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    <TextBlock Text="이상" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox Width="60"
                                         Height="22"
                                         Margin="4,0"
                                         Text="{Binding HeightValue, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Text=")" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1,0,1,1">
                        <TextBlock Text="단    면"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1,0,1,1">
                        <TextBlock Text="상 부 근"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1,0,1,1">
                        <TextBlock Text="하 부 근"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1,0,1,1">
                        <TextBlock Text="스 터 럽"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1,0,1,1">
                        <TextBlock Text="표피철근(X)"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"/>
                    </Border>

                    <controls:SectionColumnControl Grid.Row="1" Grid.RowSpan="5" Grid.Column="1"
                                                   ShowNoneCheckBox="True"
                                                   IsNone="False"
                                                   Title="{Binding LeftTitle, Mode=TwoWay}"
                                                   MValue="{Binding LeftM, Mode=TwoWay}"
                                                   VValue="{Binding LeftV, Mode=TwoWay}"
                                                   TopCount1="{Binding LeftTopCount1, Mode=TwoWay}"
                                                   TopCount2="{Binding LeftTopCount2, Mode=TwoWay}"
                                                   TopDiameter="{Binding LeftTopDiameter, Mode=TwoWay}"
                                                   BottomCount1="{Binding LeftBottomCount1, Mode=TwoWay}"
                                                   BottomCount2="{Binding LeftBottomCount2, Mode=TwoWay}"
                                                   BottomDiameter="{Binding LeftBottomDiameter, Mode=TwoWay}"
                                                   StirrupLegs="{Binding LeftStirrupLegs, Mode=TwoWay}"
                                                   StirrupDiameter="{Binding LeftStirrupDiameter, Mode=TwoWay}"
                                                   StirrupSpacing="{Binding LeftStirrupSpacing, Mode=TwoWay}"
                                                   SkinRebar="{Binding LeftSkinRebar, Mode=TwoWay}"
                                                   PreviewWidth="{Binding WidthValue}"
                                                   PreviewHeight="{Binding HeightValue}"
                                                   IsWidthOver="{Binding IsWidthOver}"
                                                   IsHeightOver="{Binding IsHeightOver}"
                                                   IsPreviewVisible="{Binding ShowLeft}"/>

                    <controls:SectionColumnControl Grid.Row="1" Grid.RowSpan="5" Grid.Column="2"
                                                   ShowNoneCheckBox="False"
                                                   Title="{Binding CenterTitle, Mode=TwoWay}"
                                                   MValue="{Binding CenterM, Mode=TwoWay}"
                                                   VValue="{Binding CenterV, Mode=TwoWay}"
                                                   TopCount1="{Binding CenterTopCount1, Mode=TwoWay}"
                                                   TopCount2="{Binding CenterTopCount2, Mode=TwoWay}"
                                                   TopDiameter="{Binding CenterTopDiameter, Mode=TwoWay}"
                                                   BottomCount1="{Binding CenterBottomCount1, Mode=TwoWay}"
                                                   BottomCount2="{Binding CenterBottomCount2, Mode=TwoWay}"
                                                   BottomDiameter="{Binding CenterBottomDiameter, Mode=TwoWay}"
                                                   StirrupLegs="{Binding CenterStirrupLegs, Mode=TwoWay}"
                                                   StirrupDiameter="{Binding CenterStirrupDiameter, Mode=TwoWay}"
                                                   StirrupSpacing="{Binding CenterStirrupSpacing, Mode=TwoWay}"
                                                   SkinRebar="{Binding CenterSkinRebar, Mode=TwoWay}"
                                                   PreviewWidth="{Binding WidthValue}"
                                                   PreviewHeight="{Binding HeightValue}"
                                                   IsWidthOver="{Binding IsWidthOver}"
                                                   IsHeightOver="{Binding IsHeightOver}"
                                                   IsPreviewVisible="{Binding ShowCenter}"/>

                    <controls:SectionColumnControl Grid.Row="1" Grid.RowSpan="5" Grid.Column="3"
                                                   ShowNoneCheckBox="True"
                                                   IsNone="False"
                                                   Title="{Binding RightTitle, Mode=TwoWay}"
                                                   MValue="{Binding RightM, Mode=TwoWay}"
                                                   VValue="{Binding RightV, Mode=TwoWay}"
                                                   TopCount1="{Binding RightTopCount1, Mode=TwoWay}"
                                                   TopCount2="{Binding RightTopCount2, Mode=TwoWay}"
                                                   TopDiameter="{Binding RightTopDiameter, Mode=TwoWay}"
                                                   BottomCount1="{Binding RightBottomCount1, Mode=TwoWay}"
                                                   BottomCount2="{Binding RightBottomCount2, Mode=TwoWay}"
                                                   BottomDiameter="{Binding RightBottomDiameter, Mode=TwoWay}"
                                                   StirrupLegs="{Binding RightStirrupLegs, Mode=TwoWay}"
                                                   StirrupDiameter="{Binding RightStirrupDiameter, Mode=TwoWay}"
                                                   StirrupSpacing="{Binding RightStirrupSpacing, Mode=TwoWay}"
                                                   SkinRebar="{Binding RightSkinRebar, Mode=TwoWay}"
                                                   PreviewWidth="{Binding WidthValue}"
                                                   PreviewHeight="{Binding HeightValue}"
                                                   IsWidthOver="{Binding IsWidthOver}"
                                                   IsHeightOver="{Binding IsHeightOver}"
                                                   IsPreviewVisible="{Binding ShowRight}"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>