<UserControl x:Class="GirderSchedule.App.Views.Controls.RebarSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,4,2"
                       VerticalAlignment="Center"
                       Text="1단"/>

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Width="32"
                     Height="20"
                     Margin="0,0,4,2"
                     Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Count1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,2,4,0"
                       VerticalAlignment="Center"
                       Text="2단"/>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Width="32"
                     Height="20"
                     Margin="0,2,4,0"
                     Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Count2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="2"
                       Width="20"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextAlignment="Right"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=TotalCount}"/>

            <TextBlock Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="3"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="- HD"/>

            <TextBox Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.Column="4"
                     Width="32"
                     Height="20"
                     VerticalAlignment="Center"
                     Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Diameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
</UserControl>