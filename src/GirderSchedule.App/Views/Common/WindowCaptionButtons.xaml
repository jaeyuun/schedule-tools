<UserControl x:Class="GirderSchedule.App.Views.Common.WindowCaptionButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Margin="4,0,0,0" ToolTip="최소화" Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource WindowIconPathStyle}" Data="M4,12 L20,12"/>
        </Button>
        <Button Margin="4,0,0,0" ToolTip="최대화" Style="{StaticResource WindowCaptionButtonStyle}" Click="MaximizeRestoreButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource WindowIconPathStyle}" Data="M6,6 L18,6 L18,18 L6,18 Z"/>
        </Button>
        <Button Margin="4,0,0,0" ToolTip="닫기" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource WindowIconPathStyle}" Data="M6,6 L18,18 M18,6 L6,18"/>
        </Button>
    </StackPanel>
</UserControl>