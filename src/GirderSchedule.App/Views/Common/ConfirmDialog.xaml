<Window x:Class="GirderSchedule.App.Views.Common.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">

    <Grid Background="Transparent" Margin="{StaticResource WindowEffectMargin}">
        <Border Style="{StaticResource WindowOuterBorderStyle}">
            <Grid Margin="{StaticResource WindowMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapXLarge}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Style="{StaticResource TitleTextStyle}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DialogContent}" Style="{StaticResource DefaultTextStyle}"/>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="예" Margin="{StaticResource HorMarginSamll}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="YesButton_Click"/>
                    <Button Content="아니오" Style="{StaticResource ModernOutlineButtonStyle}" IsCancel="True" Click="NoButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>