<Window x:Class="GirderSchedule.App.Views.Home.ProjectCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 프로젝트"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SettingWindowStyle}">

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapXLarge}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapLarge}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapMedium}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="프로젝트 정보" Style="{StaticResource TitleTextStyle}"/>

            <TextBlock Grid.Row="2" Text="프로젝트 이름" Style="{StaticResource SectionTitleTextStyle}"/>
            <TextBox Grid.Row="4" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Text="저장 위치" Style="{StaticResource SectionTitleTextStyle}"/>
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Content="..." Style="{StaticResource ModernOutlineMiniButtonStyle}" Command="{Binding BrowseCommand}"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Margin="{StaticResource HorMarginMedium}" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding BackCommand}" IsCancel="True"/>
            <Button Content="만들기" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}"/>
        </StackPanel>
    </Grid>
</Window>