<Window x:Class="GirderSchedule.App.Views.Home.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:GirderSchedule.App.ViewModels.Home"
        xmlns:views="clr-namespace:GirderSchedule.App.Views.Home"
        Title="보 일람표 툴"
        Width="1120"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type home:HomeStartViewModel}">
            <views:HomeStartView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type home:ProjectCreateWindowViewModel}">
            <views:ProjectCreateView/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>