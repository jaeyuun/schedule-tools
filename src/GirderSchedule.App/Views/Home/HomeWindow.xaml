<Window x:Class="GirderSchedule.App.Views.Home.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보 일람표 툴"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="보 일람표 툴" FontSize="28" FontWeight="Bold"/>
            <TextBlock Grid.Row="2" Text="최근 파일 열기" FontSize="20"/>

            <Grid Grid.Row="4" Width="320" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="28" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Height="28" Content="검사" Command="{Binding CheckRecentProjectsCommand}"/>
            </Grid>

            <Border Grid.Row="6" BorderBrush="#B8B8B8" BorderThickness="1" Width="520" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="18,12,18,0">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    </Expander.Header>

                                    <ListBox ItemsSource="{Binding Items}"
                                             SelectedItem="{Binding DataContext.SelectedRecentProject, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             KeyDown="RecentProjectListBox_KeyDown"
                                             MouseDoubleClick="RecentProjectListBox_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,2,0,2"/>
                                                <Setter Property="MinHeight" Value="44"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                                                <ContentPresenter Margin="2,2,2,2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                                                </Trigger>

                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch" Margin="4,2,4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="175"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="#222222" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FilePath}" Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#222222" TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Height="80" Margin="0,0,0,12" Background="#D9D9D9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="24,0" Command="{Binding OpenProjectCommand}">
                <StackPanel>
                    <TextBlock Text="프로젝트 가져오기" FontSize="22"/>
                    <TextBlock Text="폴더를 열어 프로젝트 파일을 실행합니다." Margin="0,6,0,0"/>
                </StackPanel>
            </Button>

            <Button Height="80" Margin="0,0,0,12" Background="#D9D9D9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="24,0" Command="{Binding StartSelectedProjectCommand}">
                <StackPanel>
                    <TextBlock Text="기존 프로젝트 시작하기" FontSize="22"/>
                    <TextBlock Text="최근 파일 목록 중 선택한 프로젝트 파일을 실행합니다." Margin="0,6,0,0"/>
                </StackPanel>
            </Button>

            <Button Height="80" Background="#D9D9D9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="24,0" Command="{Binding CreateProjectCommand}">
                <StackPanel>
                    <TextBlock Text="새 프로젝트 만들기" FontSize="22"/>
                    <TextBlock Text="새 프로젝트를 생성 후 실행합니다." Margin="0,6,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>