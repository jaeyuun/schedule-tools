<Window x:Class="GirderSchedule.App.Views.Home.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GirderSchedule.App.Converters"
        Title="보 일람표 툴"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <converters:SearchIconTextConverter x:Key="SearchIconTextConverter"/>

        <Style x:Key="HomeRecentExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="HeaderSite" Grid.Row="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="{StaticResource SectionCornerRadius}" Padding="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Path x:Name="Arrow" Grid.Column="0" Style="{StaticResource TreeToggleArrowPathStyle}"/>
                                                <ContentPresenter Grid.Column="1" ContentSource="Content" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Margin="18,6,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ink300Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource WindowMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource GridRowGapXLarge}"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapXLarge}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource GridRowGapLarge}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="최근 프로젝트" Style="{StaticResource TitleTextStyle}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearSearchButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Margin="8,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource SearchIconTextConverter}}"/>
                    </Button>
                </Grid>

                <Button Grid.Column="2" Content="새로고침" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding CheckRecentProjectsCommand}"/>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="18,18,18,0" Style="{StaticResource HomeRecentExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleTextStyle}"/>
                                    </Expander.Header>

                                    <ListBox ItemsSource="{Binding Items}"
                                             SelectedItem="{Binding DataContext.SelectedRecentProject, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             PreviewMouseWheel="RecentProjectListBox_PreviewMouseWheel"
                                             KeyDown="RecentProjectListBox_KeyDown"
                                             MouseDoubleClick="RecentProjectListBox_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,2"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SectionCornerRadius}" Padding="8">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue100Brush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" MinWidth="0">
                                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}"/>
                                                        <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Style="{StaticResource DefaultTextStyle}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" HorizontalAlignment="Right" Style="{StaticResource DefaultTextStyle}"/>
                                                    <TextBlock Grid.Column="2" Text=" ›" FontSize="18" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="프로젝트 시작" Margin="{StaticResource VerMarginXLarge}" Style="{StaticResource TitleTextStyle}"/>

            <Button Height="120" Margin="{StaticResource VerMarginMedium}" Style="{StaticResource ModernButtonStyle}" Command="{Binding OpenProjectCommand}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="기존 프로젝트 가져오기" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="저장된 프로젝트를 이어서 작업합니다." Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </Button>

            <Button Height="120" Style="{StaticResource ModernButtonStyle}" Command="{Binding CreateProjectCommand}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="새 프로젝트 시작하기" Margin="{StaticResource VerMarginSmall}" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="새 프로젝트 이름과 도면명을 설정합니다." Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>