<UserControl x:Class="GirderSchedule.App.Views.Home.HomeStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GirderSchedule.App.Converters">
    
    <UserControl.Resources>
        <converters:SearchIconTextConverter x:Key="SearchIconTextConverter"/>

        <Style x:Key="HomeRecentExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="HeaderSite" Grid.Row="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="6" Padding="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Path x:Name="Arrow" Grid.Column="0" Style="{StaticResource TreeToggleArrowPathStyle}"/>
                                                <ContentPresenter Grid.Column="1" ContentSource="Content" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </ToggleButton>
                            
                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Margin="18,6,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ink300Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Padding="28" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="최근 프로젝트" Style="{StaticResource WindowTitleTextStyle}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchTextBox" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Width="28" Height="28" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearSearchButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="13" Foreground="{StaticResource Ink500Brush}" Text="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource SearchIconTextConverter}}"/>
                            </Button>
                        </Grid>

                        <Button Grid.Column="2" Content="새로고침" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding CheckRecentProjectsCommand}"/>
                    </Grid>

                    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="16,12,16,0" Style="{StaticResource HomeRecentExpanderStyle}">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink900Brush}"/>
                                            </Expander.Header>

                                            <ListBox ItemsSource="{Binding Items}"
                                                     SelectedItem="{Binding DataContext.SelectedRecentProject, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     PreviewMouseWheel="RecentProjectListBox_PreviewMouseWheel"
                                                     KeyDown="RecentProjectListBox_KeyDown"
                                                     MouseDoubleClick="RecentProjectListBox_MouseDoubleClick">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="MinHeight" Value="48"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue100Brush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" MinWidth="0">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{StaticResource Ink900Brush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource Ink500Brush}" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Foreground="{StaticResource Ink500Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource Ink500Brush}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="프로젝트 시작" Style="{StaticResource WindowTitleTextStyle}"/>

                    <Button Height="120" Margin="0,12,0,0" Style="{StaticResource ModernButtonStyle}" Command="{Binding OpenProjectCommand}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="기존 프로젝트 가져오기" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink900Brush}"/>
                            <TextBlock Text="저장된 프로젝트를 이어서 작업합니다." Margin="0,8,0,0" Foreground="{StaticResource Ink500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button Height="120" Margin="0,16,0,0" Style="{StaticResource ModernButtonStyle}" Command="{Binding CreateProjectCommand}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="새 프로젝트 시작하기" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink900Brush}"/>
                            <TextBlock Text="새 프로젝트 이름과 도면명을 설정합니다." Margin="0,8,0,0" Foreground="{StaticResource Ink500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>