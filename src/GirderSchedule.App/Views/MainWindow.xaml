<Window x:Class="GirderSchedule.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GirderSchedule.App.Views"
        xmlns:vm="clr-namespace:GirderSchedule.App.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="32" Background="#FAFAFA" BorderBrush="#B8B8B8" BorderThickness="0,0,0,1">
            <Menu Background="Transparent">
                <MenuItem Header="파일">
                    <MenuItem Header="새 파일" Command="{Binding NewProjectCommand}"/>
                    <MenuItem Header="열기" Command="{Binding OpenProjectCommand}"/>
                    <Separator/>
                    <MenuItem Header="저장" Command="{Binding SaveProjectCommand}"/>
                    <MenuItem Header="다른 이름으로 저장" Command="{Binding SaveAsProjectCommand}"/>
                </MenuItem>
                <MenuItem Header="사용방법" Command="{Binding HelpCommand}"/>
            </Menu>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F7F7F7">
                <views:SchedulePreview DataContext="{Binding Editor}" Margin="16"/>
            </Border>

            <Border Grid.Column="1" Margin="8,16,16,16" Padding="14" Background="#F7F7F7" BorderBrush="#333333" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="프로젝트" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Height="24" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="보 일람표" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Height="24" Text="{Binding ScheduleTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="층 / 부재 목록" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="층+" Command="{Binding AddFloorCommand}" FontSize="10"/>
                        <Button Grid.Column="2" Content="층-" Command="{Binding RemoveFloorCommand}" FontSize="10"/>
                        <Button Grid.Column="4" Content="부+" Command="{Binding AddSetCommand}" FontSize="10"/>
                        <Button Grid.Column="5" Content="부-" Command="{Binding RemoveSetCommand}" FontSize="10"/>
                    </Grid>

                    <TreeView Grid.Row="3" ItemsSource="{Binding Floors}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FloorNodeViewModel}" ItemsSource="{Binding Sets}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                    <TextBlock Text="  [" Foreground="#777777"/>
                                    <TextBlock Text="{Binding MainRebarText}" Foreground="#777777"/>
                                    <TextBlock Text="]" Foreground="#777777"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:ScheduleSetNodeViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="층 설정" Width="76" Height="28" Margin="0,0,8,0" Command="{Binding EditFloorSettingCommand}"/>
                        <Button Content="저장" Width="70" Height="28" Margin="0,0,8,0" Command="{Binding SaveProjectCommand}"/>
                        <Button Content="내보내기" Width="80" Height="28" Command="{Binding ExportCurrentSetCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>