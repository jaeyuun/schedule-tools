<Window x:Class="GirderSchedule.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GirderSchedule.App.Views.Controls"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
    </Window.InputBindings>
    
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="32" Background="#FAFAFA" BorderBrush="#B8B8B8" BorderThickness="0,0,0,1">
            <Menu Background="Transparent">
                <MenuItem Header="파일">
                    <MenuItem Header="새 파일" Command="{Binding NewProjectCommand}"/>
                    <MenuItem Header="열기" Command="{Binding OpenProjectCommand}"/>
                    <Separator/>
                    <MenuItem Header="저장" Command="{Binding SaveProjectCommand}"/>
                    <MenuItem Header="다른 이름으로 저장" Command="{Binding SaveAsProjectCommand}"/>
                </MenuItem>
                <MenuItem Header="사용방법" Command="{Binding HelpCommand}"/>
            </Menu>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F7F7F7">
                <views:SchedulePreview DataContext="{Binding Editor}" Margin="16"/>
            </Border>

            <views:ProjectExplorer Grid.Column="1"/>
        </Grid>
    </DockPanel>
</Window>