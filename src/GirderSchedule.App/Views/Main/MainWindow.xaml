<Window x:Class="GirderSchedule.App.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GirderSchedule.App.Views.Schedule"
        Title="{Binding WindowTitle}"
        Width="1480"
        Height="900"
        MinWidth="1280"
        MinHeight="760"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
    </Window.InputBindings>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Menu DockPanel.Dock="Left" Style="{StaticResource ModernMenuBarStyle}">
                    <MenuItem Header="파일(_F)" Style="{StaticResource ModernTopMenuItemStyle}">
                        <MenuItem Header="새 일람표" Command="{Binding NewProjectCommand}" Style="{StaticResource ModernSubMenuItemStyle}"/>
                        <MenuItem Header="열기" Command="{Binding OpenProjectCommand}" Style="{StaticResource ModernSubMenuItemStyle}"/>
                        <Separator/>
                        <MenuItem Header="저장" Command="{Binding SaveProjectCommand}" Style="{StaticResource ModernSubMenuItemStyle}"/>
                        <MenuItem Header="다른 이름으로 저장" Command="{Binding SaveAsProjectCommand}" Style="{StaticResource ModernSubMenuItemStyle}"/>
                    </MenuItem>

                    <MenuItem Header="내보내기(_E)" Style="{StaticResource ModernTopMenuItemStyle}">
                        <MenuItem Header="DXF 내보내기" Command="{Binding ExportCurrentSetCommand}" Style="{StaticResource ModernSubMenuItemStyle}"/>
                        <MenuItem Header="Excel 내보내기" Command="{Binding ExportExcelCommand}" Style="{StaticResource ModernSubMenuItemStyle}"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,18,0,0">
                    <Button Style="{StaticResource ModernIconNavButtonStyle}" Command="{Binding NewProjectCommand}">
                        <StackPanel>
                            <TextBlock Text="▤" FontSize="24" Foreground="{StaticResource Blue500Brush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="새 일람표" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Blue500Brush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernIconNavButtonStyle}" Margin="0,12,0,0" Command="{Binding EditFloorSettingCommand}">
                        <StackPanel>
                            <TextBlock Text="▥" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="층 설정" Margin="0,6,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernIconNavButtonStyle}" Margin="0,12,0,0" Command="{Binding EditDxfLayerSettingCommand}">
                        <StackPanel>
                            <TextBlock Text="▧" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="DXF 설정" Margin="0,6,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <views:ProjectExplorer Grid.Column="1"/>

            <Grid Grid.Column="2" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Editor.FloorName}" Style="{StaticResource WindowTitleTextStyle}"/>
                    <TextBlock Text=" / " Margin="4,0" Style="{StaticResource WindowTitleTextStyle}"/>
                    <TextBlock Text="{Binding Editor.MemberName}" Style="{StaticResource WindowTitleTextStyle}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Border x:Name="TabAreaMask" Background="White" CornerRadius="14" IsHitTestVisible="False"/>

                    <Grid Background="{StaticResource SurfaceBrush}">
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=TabAreaMask}"/>
                        </Grid.OpacityMask>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TabControl x:Name="MainTabControl" Grid.Column="0" Background="Transparent" BorderThickness="0" Style="{StaticResource ModernTabControlStyle}" ItemContainerStyle="{StaticResource ModernTabItemStyle}" SelectionChanged="MainTabControl_SelectionChanged">
                                <TabItem Header="부재 설정"/>
                                <TabItem x:Name="PreviewTabItem" Header="미리보기 (DXF)"/>
                            </TabControl>

                            <StackPanel x:Name="PreviewToolbar" Grid.Column="1" Margin="0,0,14,0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="PreviewPrevPageButton" Content="이전" Style="{StaticResource ModernOutlineButtonStyle}" Click="PreviewPrevPageButton_Click"/>
                                <Button x:Name="PreviewNextPageButton" Margin="8,0,0,0" Content="다음" Style="{StaticResource ModernOutlineButtonStyle}" Click="PreviewNextPageButton_Click"/>
                                <Button Margin="8,0,0,0" Content="맞춤" Style="{StaticResource ModernOutlineButtonStyle}" Click="PreviewFitButton_Click"/>
                                <TextBlock x:Name="PreviewZoomTextBlock" Width="52" Margin="12,0,0,0" Text="100%" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PreviewPageTextBlock" Width="70" Margin="12,0,0,0" Text="1 / 1" Foreground="{StaticResource Ink500Brush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                            <Border x:Name="EditorTabContent" Padding="28" Background="{StaticResource SurfaceBrush}">
                                <Viewbox Stretch="Uniform">
                                    <views:ScheduleSetEditor Width="980" Height="680" DataContext="{Binding Editor}"/>
                                </Viewbox>
                            </Border>

                            <Border x:Name="PreviewTabContent" Padding="0" Background="Transparent" Visibility="Collapsed">
                                <views:ScheduleExportPreview x:Name="PreviewControl" Floors="{Binding Floors}" ScheduleTitle="{Binding ScheduleTitle}" PreviewStateChanged="PreviewControl_PreviewStateChanged"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" IsHitTestVisible="False" Panel.ZIndex="99"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>