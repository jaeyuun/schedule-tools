<UserControl x:Class="GirderSchedule.App.Views.Schedule.ScheduleSetEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GirderSchedule.App.Behaviors">

    <UserControl.Resources>
        <ResourceDictionary>

            <Style x:Key="ScheduleBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ScheduleHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource ScheduleBorderStyle}">
                <Setter Property="Background" Value="{StaticResource SubBackgroundBrush}"/>
                <Setter Property="Padding" Value="{StaticResource SectionGridMargin}"/>
            </Style>

            <Style x:Key="ScheduleContentBorderStyle" TargetType="Border" BasedOn="{StaticResource ScheduleBorderStyle}">
                <Setter Property="Padding" Value="4"/>
            </Style>

            <Style x:Key="ScheduleTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ScheduleTextBoxStyle}">
                <Setter Property="Width" Value="152"/>
            </Style>

            <Style x:Key="ScheduleMediumTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ScheduleTextBoxStyle}">
                <Setter Property="Width" Value="64"/>
            </Style>

            <Style x:Key="ScheduleSmallTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ScheduleTextBoxStyle}">
                <Setter Property="Width" Value="48"/>
            </Style>

            <DataTemplate x:Key="RebarInputTemplate">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapLarge}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DefaultTextStyle}" Text="1단"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource ScheduleSmallTextBoxStyle}" Text="{Binding TopCount1, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ScheduleCellTextBlockStyle}" Text="2단"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ScheduleSmallTextBoxStyle}" Text="{Binding TopCount2, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" HorizontalAlignment="Right" TextAlignment="Right" Style="{StaticResource ScheduleCellTextBlockStyle}" Text="{Binding TopTotalCount}"/>
                    <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="5" Style="{StaticResource DefaultTextStyle}" Text="- HD"/>
                    <TextBox Grid.Row="0" Grid.RowSpan="3" Grid.Column="7" Style="{StaticResource ScheduleSmallTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="MainRebarDiameter" behaviors:NumericTextBoxBehavior.AllowNegative="False"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BottomRebarInputTemplate">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapLarge}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DefaultTextStyle}" Text="2단"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Style="{StaticResource ScheduleSmallTextBoxStyle}" Text="{Binding BottomCount2, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DefaultTextStyle}" Text="1단"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ScheduleSmallTextBoxStyle}" Text="{Binding BottomCount1, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" HorizontalAlignment="Right" TextAlignment="Right" Style="{StaticResource DefaultTextStyle}" Text="{Binding BottomTotalCount}"/>
                    <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="5" Style="{StaticResource DefaultTextStyle}" Text="- HD"/>
                    <TextBox Grid.Row="0" Grid.RowSpan="3" Grid.Column="7" Style="{StaticResource ScheduleSmallTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="MainRebarDiameter" behaviors:NumericTextBoxBehavior.AllowNegative="False"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="StirrupInputTemplate">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ScheduleSmallTextBoxStyle}" Text="{Binding StirrupLegs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="- HD" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource DefaultTextStyle}"/>
                    <TextBox Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ScheduleSmallTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="StirrupDiameter" behaviors:NumericTextBoxBehavior.AllowNegative="False"/>
                    <TextBlock Text="@" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ScheduleCellTextBlockStyle}"/>
                    <TextBox Style="{StaticResource ScheduleMediumTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="StirrupSpacing" behaviors:NumericTextBoxBehavior.AllowNegative="False"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="SkinRebarInputTemplate">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource VerMarginSmall}" HorizontalAlignment="Center" IsEnabled="{Binding IsSkinRebarInputEnabled}">
                        <TextBlock Text="HD" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource DefaultTextStyle}"/>
                        <TextBox Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ScheduleSmallTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="SkinRebarDiameter" behaviors:NumericTextBoxBehavior.AllowNegative="False"/>
                        <TextBlock Text="@" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource DefaultTextStyle}"/>
                        <TextBox Style="{StaticResource ScheduleMediumTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="SkinRebarSpacing" behaviors:NumericTextBoxBehavior.AllowNegative="False"/>
                    </StackPanel>

                    <TextBox Style="{StaticResource ScheduleTextBoxStyle}" Text="{Binding SkinRebarNote, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsSkinRebarInputEnabled}"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="MemberForceInputTemplate">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource GridRowGapMedium}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="{StaticResource HorMarginSmall}" Text="M=" Style="{StaticResource DefaultTextStyle}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ScheduleMediumTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="MomentValue" behaviors:NumericTextBoxBehavior.AllowNegative="True"/>
                    <TextBlock Grid.Column="3" Margin="{StaticResource HorMarginSmall}" Text="V=" Style="{StaticResource DefaultTextStyle}"/>
                    <TextBox Grid.Column="4" Style="{StaticResource ScheduleMediumTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="ShearValue" behaviors:NumericTextBoxBehavior.AllowNegative="True"/>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" BorderThickness="1" Style="{StaticResource ScheduleHeaderBorderStyle}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="부 재 명" Style="{StaticResource ScheduleLabelStyle}"/>
                <TextBlock Text="( B × H )" Style="{StaticResource ScheduleLabelStyle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" BorderThickness="0,1,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="{StaticResource HorMarginSmall}" HorizontalAlignment="Right" Text="{Binding DisplayFloorPrefix}" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ScheduleTextBoxStyle}" Text="{Binding MemberName, UpdateSourceTrigger=LostFocus}"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="(" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource DefaultTextStyle}"/>
                    <TextBox Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ScheduleMediumTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="WidthValue" behaviors:NumericTextBoxBehavior.AllowNegative="False" behaviors:NumericTextBoxBehavior.UpdateSourceOnTextChanged="True"/>
                    <TextBlock Text="×" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource DefaultTextStyle}"/>
                    <CheckBox Content="이상" Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding IsHeightOver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Margin="{StaticResource HorMarginSmall}" Style="{StaticResource ScheduleMediumTextBoxStyle}" behaviors:NumericTextBoxBehavior.PropertyName="HeightValue" behaviors:NumericTextBoxBehavior.AllowNegative="False" behaviors:NumericTextBoxBehavior.UpdateSourceOnTextChanged="True"/>
                    <TextBlock Text=")" Style="{StaticResource DefaultTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderThickness="1,0,1,1" Style="{StaticResource ScheduleHeaderBorderStyle}">
            <TextBlock Text="단    면" Style="{StaticResource ScheduleLabelStyle}"/>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" BorderThickness="1,0,1,1" Style="{StaticResource ScheduleHeaderBorderStyle}">
            <TextBlock Text="상 부 근" Style="{StaticResource ScheduleLabelStyle}"/>
        </Border>

        <Border Grid.Row="3" Grid.Column="0" BorderThickness="1,0,1,1" Style="{StaticResource ScheduleHeaderBorderStyle}">
            <TextBlock Text="하 부 근" Style="{StaticResource ScheduleLabelStyle}"/>
        </Border>

        <Border Grid.Row="4" Grid.Column="0" BorderThickness="1,0,1,1" Style="{StaticResource ScheduleHeaderBorderStyle}">
            <TextBlock Text="스 터 럽" Style="{StaticResource ScheduleLabelStyle}"/>
        </Border>

        <Border Grid.Row="5" Grid.Column="0" BorderThickness="1,0,1,1" Style="{StaticResource ScheduleHeaderBorderStyle}">
            <TextBlock Text="표피철근(X)" Style="{StaticResource ScheduleLabelStyle}"/>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding Left.IsSectionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Style="{StaticResource ScheduleTextBoxStyle}" IsEnabled="{Binding Left.IsSectionEnabled}" Text="{Binding Left.Position, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>

                <ContentControl Grid.Row="2" IsEnabled="{Binding Left.IsSectionEnabled}" Content="{Binding Left}" ContentTemplate="{StaticResource MemberForceInputTemplate}"/>
                <Canvas x:Name="LeftCanvas" Grid.Row="4" MinWidth="200" MinHeight="240" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <TextBox Grid.Row="6" Style="{StaticResource ScheduleTextBoxStyle}" IsEnabled="{Binding Left.IsSectionEnabled}" Text="{Binding Left.SectionNote, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Left.IsSectionEnabled}">
            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource RebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="3" Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Left.IsSectionEnabled}">
            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource BottomRebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="4" Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Left.IsSectionEnabled}">
            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource StirrupInputTemplate}"/>
        </Border>

        <Border Grid.Row="5" Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Left.IsSectionEnabled}">
            <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource SkinRebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Style="{StaticResource ScheduleTextBoxStyle}" Text="{Binding Center.Position, UpdateSourceTrigger=LostFocus}"/>
                <ContentControl Grid.Row="2" Content="{Binding Center}" ContentTemplate="{StaticResource MemberForceInputTemplate}"/>
                <Canvas x:Name="CenterCanvas" Grid.Row="4" Width="200" MinHeight="240" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <TextBox Grid.Row="6" Style="{StaticResource ScheduleTextBoxStyle}" IsEnabled="{Binding Center.IsSectionEnabled}" Text="{Binding Center.SectionNote, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <ContentControl Content="{Binding Center}" ContentTemplate="{StaticResource RebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="3" Grid.Column="2" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <ContentControl Content="{Binding Center}" ContentTemplate="{StaticResource BottomRebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="4" Grid.Column="2" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <ContentControl Content="{Binding Center}" ContentTemplate="{StaticResource StirrupInputTemplate}"/>
        </Border>

        <Border Grid.Row="5" Grid.Column="2" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <ContentControl Content="{Binding Center}" ContentTemplate="{StaticResource SkinRebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="1" Grid.Column="3" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="{StaticResource GridRowGapSmall}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox VerticalAlignment="Center" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding Right.IsSectionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Style="{StaticResource ScheduleTextBoxStyle}" IsEnabled="{Binding Right.IsSectionEnabled}" Text="{Binding Right.Position, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>

                <ContentControl Grid.Row="2" IsEnabled="{Binding Right.IsSectionEnabled}" Content="{Binding Right}" ContentTemplate="{StaticResource MemberForceInputTemplate}"/>
                <Canvas x:Name="RightCanvas" Grid.Row="4" Width="200" MinHeight="240" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <TextBox Grid.Row="6" Style="{StaticResource ScheduleTextBoxStyle}" IsEnabled="{Binding Right.IsSectionEnabled}" Text="{Binding Right.SectionNote, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="3" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Right.IsSectionEnabled}">
            <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource RebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="3" Grid.Column="3" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Right.IsSectionEnabled}">
            <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource BottomRebarInputTemplate}"/>
        </Border>

        <Border Grid.Row="4" Grid.Column="3" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Right.IsSectionEnabled}">
            <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource StirrupInputTemplate}"/>
        </Border>

        <Border Grid.Row="5" Grid.Column="3" BorderThickness="0,0,1,1" Style="{StaticResource ScheduleContentBorderStyle}" IsEnabled="{Binding Right.IsSectionEnabled}">
            <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource SkinRebarInputTemplate}"/>
        </Border>
    </Grid>
</UserControl>