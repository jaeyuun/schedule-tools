<UserControl x:Class="GirderSchedule.App.Views.Schedule.ProjectExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GirderSchedule.App.ViewModels.Schedule">

    <Border Padding="16,18,16,28" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Margin="4,0" Text="도면명" Style="{StaticResource WindowTitleTextStyle}"/>
                <TextBox Margin="0,14,0,0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ScheduleTitle, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Margin="4,0" Text="층 / 부재" Style="{StaticResource WindowTitleTextStyle}"/>
                <Button Grid.Column="2" Height="28" Content="추가" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding AddSetCommand}"/>
                <Button Grid.Column="4" Height="28" Content="삭제" Style="{StaticResource ModernOutlineButtonStyle}" Command="{Binding RemoveSetCommand}"/>
            </Grid>

            <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                <TreeView x:Name="ProjectTreeView" Focusable="True" ItemsSource="{Binding Floors}" Background="Transparent" BorderThickness="0" AllowDrop="True" Padding="8" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.InputBindings>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyScheduleSetCommand}"/>
                        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteScheduleSetCommand}"/>
                    </TreeView.InputBindings>

                    <TreeView.Resources>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                        <Grid>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0,0,16,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right" Panel.ZIndex="10" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="FullRowTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="MinHeight" Value="28"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" MinHeight="{TemplateBinding MinHeight}" Padding="4,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton x:Name="Expander" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                    <Border Background="Transparent">
                                                                        <Path x:Name="Arrow" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource Ink500Brush}" Data="M 0 0 L 0 6 L 6 3 Z"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90" CenterX="3" CenterY="3"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>

                                                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                    </Grid>
                                                </Border>

                                                <Border x:Name="DropTopLine" Height="2" VerticalAlignment="Top" Background="#2678FF" Visibility="Collapsed"/>
                                                <Border x:Name="DropBottomLine" Height="2" VerticalAlignment="Bottom" Background="#2678FF" Visibility="Collapsed"/>
                                            </Grid>

                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="18,0,0,0"/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsChildSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue050Brush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue100Brush}"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="DropTop">
                                                <Setter TargetName="DropTopLine" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="DropBottom">
                                                <Setter TargetName="DropBottomLine" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsSelectionActive" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue100Brush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                        </Style>

                        <HierarchicalDataTemplate DataType="{x:Type vm:FloorNodeViewModel}" ItemsSource="{Binding Sets}">
                            <Grid HorizontalAlignment="Stretch" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding FloorName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink900Brush}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="[" Foreground="{StaticResource Ink500Brush}"/>
                                    <TextBlock Text="{Binding MainRebarText}" Foreground="{StaticResource Ink500Brush}"/>
                                    <TextBlock Text="/" Foreground="{StaticResource Ink500Brush}"/>
                                    <TextBlock Text="{Binding StirrupText}" Foreground="{StaticResource Ink500Brush}"/>
                                    <TextBlock Text="]" Foreground="{StaticResource Ink500Brush}"/>
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type vm:ScheduleSetNodeViewModel}">
                            <Grid HorizontalAlignment="Stretch" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayMemberName}" VerticalAlignment="Center" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Ink700Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Blue500Brush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" Style="{StaticResource ModernContextMenuStyle}">
                                            <MenuItem Header="복사" Command="{Binding CopyScheduleSetCommand}" Style="{StaticResource ModernContextMenuItemStyle}"/>
                                            <MenuItem Header="붙여넣기" Command="{Binding PasteScheduleSetCommand}" Style="{StaticResource ModernContextMenuItemStyle}"/>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemContainerStyle>
                        <StaticResource ResourceKey="FullRowTreeViewItemStyle"/>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </Grid>
    </Border>
</UserControl>