<UserControl x:Class="GirderSchedule.App.Views.Schedule.ScheduleExportPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB">

    <Border Background="#F3F6FB" CornerRadius="0,0,14,14" ClipToBounds="True">
        <Grid Background="#F3F6FB">
            <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PreviewHost" Background="#F3F6FB">
                    <Canvas x:Name="PreviewCanvas" Width="1180" Height="820" Background="White">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Canvas.LayoutTransform>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>