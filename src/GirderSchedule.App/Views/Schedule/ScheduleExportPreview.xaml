<UserControl x:Class="GirderSchedule.App.Views.Schedule.ScheduleExportPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SubBackgroundBrush}">

    <Border Background="{StaticResource SubBackgroundBrush}" CornerRadius="10" ClipToBounds="True">
        <Grid Background="{StaticResource SubBackgroundBrush}">
            <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PreviewHost" Background="{StaticResource SubBackgroundBrush}">
                    <Canvas x:Name="PreviewCanvas" Width="1100" Height="800" Background="White">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Canvas.LayoutTransform>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>