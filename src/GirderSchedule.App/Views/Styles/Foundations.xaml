<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryLightColor">#EFF6FF</Color>
    <Color x:Key="PrimarySoftColor">#DBEAFE</Color>
    <Color x:Key="PrimaryBorderColor">#93C5FD</Color>

    <Color x:Key="AppBackgroundColor">#FCFCFC</Color>
    <Color x:Key="SubBackgroundColor">#F3F6FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#F1F5F9</Color>
    <Color x:Key="LineColor">#E2E8F0</Color>

    <Color x:Key="Ink900Color">#0F172A</Color>
    <Color x:Key="Ink700Color">#334155</Color>
    <Color x:Key="Ink500Color">#64748B</Color>
    <Color x:Key="Ink300Color">#CBD5E1</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource PrimaryBorderColor}"/>

    <SolidColorBrush x:Key="Blue050Brush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="Blue100Brush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="Blue500Brush" Color="{StaticResource PrimaryColor}"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>

    <SolidColorBrush x:Key="Ink900Brush" Color="{StaticResource Ink900Color}"/>
    <SolidColorBrush x:Key="Ink700Brush" Color="{StaticResource Ink700Color}"/>
    <SolidColorBrush x:Key="Ink500Brush" Color="{StaticResource Ink500Color}"/>
    <SolidColorBrush x:Key="Ink300Brush" Color="{StaticResource Ink300Color}"/>

    <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="MenuPressedBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource LineColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SubBackgroundBrush" Color="{StaticResource SubBackgroundColor}"/>
    <SolidColorBrush x:Key="DropLineBrush" Color="{StaticResource PrimaryColor}"/>

    <SolidColorBrush x:Key="ScheduleTableLineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="ScheduleTableHeaderBrush" Color="{StaticResource SubBackgroundColor}"/>

    <sys:Double x:Key="DefaultFontSize">12</sys:Double>

</ResourceDictionary>
