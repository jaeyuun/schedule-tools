<Window x:Class="GirderSchedule.App.Views.Export.DxfExportSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF 내보내기 설정"
        Width="720"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OkCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SettingButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#B8B8B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="SettingTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Border Margin="24" Padding="18" Background="#F7F7F7" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="DXF 내보내기 설정" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="층 출력 방식" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox Content="층 구분 없이 이어서 출력" IsChecked="{Binding ContinueAcrossFloors, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <TextBlock Text="체크하면 층이 바뀌어도 이어서 출력하고, 체크 해제하면 층이 바뀔 때 다음 줄부터 출력합니다." Foreground="#666666" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="폼 배치" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="폼 가로 개수" Width="100" VerticalAlignment="Center"/>
                            <TextBox Width="80" Style="{StaticResource SettingTextBoxStyle}" Text="{Binding FormColumnCountText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="개" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="기본값: 3" VerticalAlignment="Center" Foreground="#666666" Margin="24,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="폼 1개는 부재 9세트 기준입니다. 예: 4 입력 시 폼1 폼2 폼3 폼4 / 폼5 폼6 ..." Foreground="#666666" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="확인" Width="80" Margin="0,0,8,0" Style="{StaticResource SettingButtonStyle}" Command="{Binding OkCommand}"/>
                <Button Content="취소" Width="80" Style="{StaticResource SettingButtonStyle}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>